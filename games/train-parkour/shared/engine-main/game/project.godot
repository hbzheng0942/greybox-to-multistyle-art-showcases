; Engine configuration file. Prefer editor changes, coordinated by one owner.
config_version=5

[application]
config/name="Greybox Art Showcase - Train Parkour"
config/version="0.4.0-alpha.1"
run/main_scene="res://showcase_entries/halloween_comic.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[input]
steer_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
steer_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
brake_drift={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
trick_roll={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":74)]
}
trick_spin={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":75)]
}
manual_front={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
manual_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
restart={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82)]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}

pace_1={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":49)]
}
pace_2={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":50)]
}
pace_3={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":51)]
}
comfort={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":86)]
}
mute={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":77)]
}

[physics]
common/physics_interpolation = true

[rendering]
renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.055, 0.067, 0.09, 1)

[layer_names]
3d_physics/layer_1="World"
3d_physics/layer_2="Player"
